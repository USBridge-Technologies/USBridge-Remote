#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D curTex;
layout(binding = 1) uniform sampler2D flowTex;
layout(binding = 2, rgba8) uniform writeonly image2D outImg;
layout(push_constant) uniform PC {
    ivec2 dstSize;
    ivec2 blockSize;
    float extrapolateT;
} pc;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.dstSize.x || p.y >= pc.dstSize.y) return;
    vec2 flowUV = (vec2(p) + 0.5) / vec2(pc.dstSize);
    vec2 v = texture(flowTex, flowUV).rg;
    // 1. HARD CLAMP
    float max_disp = 24.0;
    if (length(v) > max_disp) {
        v = normalize(v) * max_disp;
    }
    // 2. DAMPING (A*k=1 for linear start, asymptotes at A=3.0)
    float t_eff = 3.0 * (1.0 - exp(-0.3333 * pc.extrapolateT));
    vec2 srcPx = vec2(p) - t_eff * v;
    vec2 srcUV = (srcPx + 0.5) / vec2(pc.dstSize);
    srcUV = clamp(srcUV, vec2(0.0), vec2(1.0));
    vec4 color = texture(curTex, srcUV);
    imageStore(outImg, p, color);
}